# Только локальный демонстрационный пароль. Для реального стенда задайте уникальный секрет в .env.
COMPOSE_PROJECT_NAME=practice-savva
# Для runner задайте постоянный абсолютный каталог вне временного checkout. Локально точка означает корень проекта.
DEPLOY_DIR=.
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=change_me_before_deployment
POSTGRES_PORT=5432
APP_PORT=8080
APP_IMAGE=support-ticket-service:local
RESTORE_DB=support_restore
HEALTH_ATTEMPTS=18
HEALTH_INTERVAL_SECONDS=5
HEALTH_REQUEST_TIMEOUT_SECONDS=5
HEALTH_MAX_WAIT_SECONDS=90
